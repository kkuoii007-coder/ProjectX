# Philosophy Reader environment template.
# Copy to .env and fill values locally. NEVER commit a real .env.
# On the production host only OPENROUTER_API_KEY lives in .env;
# DB and Django secrets are provided by the systemd EnvironmentFile
# /etc/philosophy-reader/service.env (mode 0640, root:prdr).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-dev-only
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=philosophy_reader
DB_USER=philosophy_reader
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Live AI stays disabled until the owner sets explicit budgets.
LIVE_AI_ENABLED=false
AI_PROVIDER=fake
AI_GENERATION_MODEL=anthropic/claude-sonnet-4.5
AI_REVIEW_MODEL=anthropic/claude-sonnet-4.5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
OWNER_DAILY_BUDGET_USD=
OWNER_MONTHLY_BUDGET_USD=

# The only secret intended for .env on the server:
OPENROUTER_API_KEY=

REGISTRATION_MODE=invite
TOPUP_MODE=manual_test
WEB_SEARCH_ENABLED=false
WEB_FETCH_ENABLED=false
